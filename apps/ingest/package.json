{
  "name": "@tokengrid/ingest",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "dev": "tsx watch --env-file-if-exists=../../.env src/worker.ts",
    "start": "tsx --env-file-if-exists=../../.env src/worker.ts",
    "replay": "tsx --env-file-if-exists=../../.env src/replay.ts",
    "redrive": "tsx --env-file-if-exists=../../.env src/redrive.ts"
  },
  "dependencies": {
    "@tokengrid/db": "workspace:*",
    "@tokengrid/shared": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "ioredis": "^5.11.1"
  }
}
