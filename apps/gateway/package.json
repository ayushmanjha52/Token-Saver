{
  "name": "@tokengrid/gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "acceptance:stage1": "tsx --env-file-if-exists=../../.env scripts/stage1-acceptance.ts"
  },
  "dependencies": {
    "@tokengrid/db": "workspace:*",
    "@tokengrid/shared": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "ioredis": "^5.11.1",
    "undici": "^7.30.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.131.0"
  }
}
