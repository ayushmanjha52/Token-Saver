{
  "name": "tokengrid",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "typecheck": "pnpm -r --parallel run typecheck",
    "test": "pnpm -r run test",
    "db:migrate": "pnpm --filter @tokengrid/db run migrate",
    "db:seed": "pnpm --filter @tokengrid/db run seed",
    "dev:gateway": "pnpm --filter @tokengrid/gateway run dev",
    "dev:ingest": "pnpm --filter @tokengrid/ingest run dev",
    "test:integration": "pnpm --filter @tokengrid/integration test:integration",
    "dev:web": "pnpm --filter @tokengrid/web run dev",
    "build:services": "node scripts/build-services.mjs",
    "build:web": "pnpm --filter @tokengrid/web build"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "esbuild": "^0.28.2"
  }
}
