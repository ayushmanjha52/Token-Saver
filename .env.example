DATABASE_URL=postgres://tokengrid:tokengrid@localhost:5432/tokengrid
REDIS_URL=redis://localhost:6379

# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Local envelope encryption refuses to run when NODE_ENV=production.
TOKENGRID_LOCAL_KEK=

# Gateway
GATEWAY_PORT=8787
ANTHROPIC_UPSTREAM_URL=https://api.anthropic.com

# Seed only: the org's real Anthropic key, encrypted into provider_credentials.
# Use a key from a dedicated workspace so the console's daily cost is
# comparable to TokenGrid's sum during the Stage 1 acceptance test.
SEED_ANTHROPIC_API_KEY=
