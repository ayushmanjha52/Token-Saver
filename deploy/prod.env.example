# deploy/prod.env — values for docker-compose.prod.yml. Never commit the filled copy.
POSTGRES_PASSWORD=
# 32+ random characters; the same value must be given to the admin CLI when issuing sign-in links.
TOKENGRID_SESSION_SECRET=
# AWS KMS symmetric key (ARN or alias) used to envelope-encrypt provider keys.
TOKENGRID_KMS_KEY_ID=
AWS_REGION=
# Prefer an instance role; static keys only where no role is available.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
ALERT_WEBHOOK_URL=
